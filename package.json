{
  "name": "@local/deepseek-pure-chat",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DeepSeek-web-style pure chat mode for DeepSeek Harness: chat-only surface with model switching, reasoning effort, web search, and image attachments.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
